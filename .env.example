# wa-portal configuration — copy to .env and fill in.
# NEVER commit the real .env (it's gitignored).

PORT=4200
NODE_ENV=development

# Random long string used to sign session cookies.
SESSION_SECRET=generate-a-long-random-string

# Postgres. Local dev against the docker-compose DB uses port 5433.
DATABASE_URL=postgres://waportal:CHANGE_ME@localhost:5433/waportal

# ── WhatsApp provider ────────────────────────────────────────────────────────
# "cloud"  = Meta WhatsApp Cloud API (current)
# "openwa" = legacy self-hosted OpenWA gateway
WHATSAPP_PROVIDER=cloud

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
META_GRAPH_VERSION=v21.0

# Permanent System User token (Business Settings -> System Users -> Generate).
# Needs whatsapp_business_messaging + whatsapp_business_management.
META_ACCESS_TOKEN=

# From WhatsApp Manager / API Setup for your number.
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Any random string; must match what you enter in the Meta webhook config.
META_WEBHOOK_VERIFY_TOKEN=pick-a-random-verify-token

# Meta App -> Settings -> Basic -> App Secret. Used to verify webhook signatures.
META_APP_SECRET=

# Language code used for template sends (outside the 24h window).
META_TEMPLATE_LANG=en_US

# ── Legacy OpenWA gateway (only if WHATSAPP_PROVIDER=openwa) ─────────────────
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
PORTAL_WEBHOOK_URL=http://host.docker.internal:4200/whatsapp/webhook

# Shared secret embedded in the legacy webhook path.
WEBHOOK_SECRET=generate-a-long-random-string

# ── OpenAI (message classification + the operator assistant) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Atlassian / Jira OAuth ───────────────────────────────────────────────────
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:4200/jira/callback

# Word that starts the customer support flow.
TRIGGER_PHRASE=hi genie

# ── Optional: push new tickets into Service Genie immediately ────────────────
SERVICE_GENIE_SYNC_URL=
SERVICE_GENIE_CRON_SECRET=
